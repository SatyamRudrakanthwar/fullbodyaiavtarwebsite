{
  "name": "avatar-guide",
  "version": "1.0.0",
  "description": "Full-body 3D AI avatar that guides visitors around any single-page website.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build && vite build --config vite.widget.config.js",
    "start": "node server/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "concurrently": "^10.0.6",
    "three": "^0.187.0",
    "vite": "^8.3.5"
  },
  "license": "MIT"
}
