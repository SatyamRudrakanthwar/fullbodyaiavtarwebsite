# Pick ONE provider by adding its key. The server uses the first key it finds,
# or set LLM_PROVIDER explicitly (anthropic | groq | gemini | openrouter | ollama).

# --- Free options ---
# Groq (free tier, very fast): https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# Google Gemini (free tier): https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# OpenRouter (free ":free" models): https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
# Ollama (runs on your PC, no key): install from https://ollama.com, run `ollama pull llama3.1`
# LLM_PROVIDER=ollama

# --- Claude (paid) ---
# ANTHROPIC_API_KEY=sk-ant-...
# AVATAR_MODEL=claude-opus-5-5
# AVATAR_EFFORT=low

# Optional: override the model / endpoint for any OpenAI-compatible provider
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

PORT=8787
# Comma-separated origins allowed to call the API from embedded pages ("*" = any)
# ALLOWED_ORIGINS=*
